# 复制为 .env.local 后填实际值. .env.local 已被 .gitignore 排除, 不会提交.

# Notion Integration Token (必填)
# 创建步骤:
#   1. 打开 https://www.notion.so/profile/integrations
#   2. 点 + New integration, 名字填 sanmu-website, Type 选 Internal, Workspace 选你的
#   3. Save 后复制 Internal Integration Secret (secret_xxx...)
#   4. 打开 https://www.notion.so/scotpan/370c4735c2368146a733fd3276d4c922
#      → 进入 📝 Blog 博客 数据库 → 右上角 ... → Connections → 加 sanmu-website
#      → 进入 Events 线下活动 数据库, 同上操作
NOTION_TOKEN=secret_xxx_paste_here

# 备注: NOTION_BLOG_DATA_SOURCE_ID 已硬编码在 lib/notion.ts (319407d1-e400-4aed-8e36-dfa0ab19e6ea),
# 不用在这里配置. 如果以后 Notion 库换了, 改 lib/notion.ts 那一行即可.

# IndexNow (Bing/Yandex/Seznam 实时索引通知)
# 任意 8-128 字符 hex 字符串. 用 `node -e "console.log(require('crypto').randomUUID().replace(/-/g,''))"` 生成
INDEXNOW_KEY=your_indexnow_key_here
# /api/indexnow 触发端点的 Bearer token. 调用方需带 Authorization: Bearer ${INDEXNOW_SECRET}
# 用 `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"` 生成
INDEXNOW_SECRET=your_random_token_here
